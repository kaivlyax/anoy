# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001

# Database & Authentication
MONGO_URI=mongodb://127.0.0.1:27017/anoy
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Media Storage Configuration (Cloudinary - Optional, falls back to secure local static storage if not provided)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service Configuration (Nodemailer / SMTP)
# Option 1: Custom SMTP (e.g. SendGrid, Mailgun, Resend, Amazon SES, Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="ANOY" <noreply@anoy.social>

# Option 2: Pre-configured Service Shortcut (e.g. gmail, sendgrid, mailgun)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

