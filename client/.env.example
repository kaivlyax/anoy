# ANOY Frontend Environment Variables
# In production (e.g. on custom domain anoyy.tech):
# VITE_API_URL=https://anoyy.tech/api/v1 (or https://api.anoyy.tech/api/v1)
# VITE_SOCKET_URL=https://anoyy.tech (or https://api.anoyy.tech)
VITE_API_URL=http://localhost:5001/api/v1
VITE_SOCKET_URL=http://localhost:5001

# Razorpay Standard Web Checkout (Test Mode Key ID - safe for frontend)
VITE_RAZORPAY_KEY_ID=
